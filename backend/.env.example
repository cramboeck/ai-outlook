# PostPilot Backend Configuration

# Server
PORT=7071
NODE_ENV=development

# Database (local Docker or remote)
DATABASE_URL=postgres://postpilot:postpilot_dev_123@localhost:5432/postpilot
DATABASE_SSL=false

# Azure AD (for token validation)
AZURE_CLIENT_ID=ceadafb1-0ad1-4088-af18-96809db0f9ad

# Azure AD - On-Behalf-Of flow (optional, only needed for Copilot premium)
# Create a client secret in the App Registration's "Certificates & secrets"
# and paste the VALUE here. AZURE_TENANT_ID should be the tenant GUID, or
# "common" / "organizations" for a multi-tenant app.
# AZURE_CLIENT_SECRET=your-client-secret-value-here
# AZURE_TENANT_ID=common

# CORS (frontend URL)
CORS_ORIGIN=http://localhost:5173

# Development: Skip auth for testing (set to true for local dev without tokens)
SKIP_AUTH=true

# OpenAI (for AI features) - Use ONE of these options:

# Option 1: OpenAI API (recommended for local dev)
# OPENAI_API_KEY=sk-your-key-here
# OPENAI_MODEL=gpt-4o-mini

# Option 2: Azure OpenAI (for production)
AZURE_OPENAI_ENDPOINT=your-azure-openai-endpoint
AZURE_OPENAI_API_KEY=your-azure-openai-key-here
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
