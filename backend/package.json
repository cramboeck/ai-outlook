{
  "name": "postpilot-backend",
  "version": "1.0.0",
  "description": "PostPilot Backend - Runs locally (Express) or on Azure (Functions)",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "dev": "npx tsx watch src/server.ts",
    "start": "node dist/server.js",
    "start:azure": "func start",
    "db:migrate": "npx tsx src/db/migrate.ts",
    "db:seed": "npx tsx src/db/seed.ts",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@azure/functions": "^4.5.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.3.2",
    "jsonwebtoken": "^9.0.2",
    "jwks-rsa": "^3.1.0",
    "openai": "^4.68.0",
    "pg": "^8.11.3",
    "uuid": "^9.0.1",
    "winston": "^3.19.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.0.0",
    "@types/pg": "^8.10.9",
    "@types/uuid": "^9.0.7",
    "rimraf": "^6.0.1",
    "tsx": "^4.7.0",
    "typescript": "^5.6.0"
  }
}
