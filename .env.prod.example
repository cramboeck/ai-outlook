# MailSort Production Environment
# Copy this file to .env.prod (gitignored) and fill in real values.

# ---- Public URL ----
# Die volle HTTPS-URL unter der MailSort erreichbar ist. Der ramboflow-nginx
# proxied auf diese Domain zu mailsort-frontend / mailsort-backend.
# Diese URL wird auch beim Vite-Build in den Frontend-Bundle gebaked.
PUBLIC_URL=https://mail.ramboeck.it

# ---- Postgres ----
# Container-only Credentials — Postgres wird nicht auf dem Host exposed
# und ist ausschließlich vom Backend-Container aus über das private
# mailsort-net erreichbar.
POSTGRES_USER=mailsort
POSTGRES_PASSWORD=change-me-to-a-long-random-string
POSTGRES_DB=mailsort

# ---- Backups ----
BACKUP_RETENTION_DAYS=14

# ---- Azure AD (Multi-tenant M365 app) ----
AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_SECRET=your-client-secret-value-here
# "common" für Multi-Tenant, oder spezifische Tenant-GUID für Single-Tenant.
AZURE_TENANT_ID=common

# ---- AI Provider — pick ONE block ----

# Option A: Azure OpenAI (empfohlen für Prod, EU-Datenhaltung)
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_API_KEY=your-azure-openai-key-here
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini

# Option B: Ollama (self-hosted, günstig) — auskommentieren wenn nicht gewünscht
# OPENAI_API_KEY=ollama
# OPENAI_BASE_URL=http://192.168.1.42:11434/v1
# OPENAI_MODEL=qwen2.5:14b
