# MailSort Production Environment
# Copy this file to .env.prod (which is gitignored) and fill in real values.

# ---- Public URL ----
# The full https:// URL where the app is reachable. Used for CORS + as the
# base URL Vite bakes into the frontend bundle.
PUBLIC_URL=https://mailsort.example.com

# ---- Host-side port mapping ----
# These are bound to 127.0.0.1 on the Docker host, then reverse-proxied
# by host-nginx. Change only if 17071/17080 are already in use by another
# app on the same box.
BACKEND_HOST_PORT=17071
FRONTEND_HOST_PORT=17080

# ---- Postgres ----
# Container-only credentials — the database itself is not exposed on the
# host, only reachable through the mailsort-net bridge network.
POSTGRES_USER=mailsort
POSTGRES_PASSWORD=change-me-to-a-long-random-string
POSTGRES_DB=mailsort

# ---- Backups ----
BACKUP_RETENTION_DAYS=14

# ---- Azure AD (Multi-tenant M365 app) ----
AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_SECRET=your-client-secret-value-here
# Use "common" for a multi-tenant app, or a specific tenant GUID.
AZURE_TENANT_ID=common

# ---- AI Provider — pick ONE block ----

# Option A: Azure OpenAI (recommended for production, EU data residency)
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_API_KEY=your-azure-openai-key-here
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini

# Option B: Ollama (self-hosted, cheap) — uncomment to switch
# OPENAI_API_KEY=ollama
# OPENAI_BASE_URL=http://192.168.1.42:11434/v1
# OPENAI_MODEL=qwen2.5:14b
